										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAABfbQ+4YNuhoI=",
											"_parent": {
												"$ref": "AAAAAAABfqwt8qMFgwQ="
											},
											"font": "Arial;13;0",
											"left": 60,
											"top": 200,
											"width": 430,
											"height": 62,
											"text": "Transport is chosen once at boot: GPIO26 HIGH -> WiFiBackendTransport\n(production); GPIO26 LOW -> SerialBackendTransport + tools/serial-bridge,\nwhich forwards the same frames to this REST API (demonstration only)."
										},
										{
											"_type": "UMLNoteLinkView",
											"_id": "AAAAAAABxDtjFTdx64M=",
											"_parent": {
												"$ref": "AAAAAAABfqwt8qMFgwQ="
											},
											"font": "Arial;13;0",
											"head": {
												"$ref": "AAAAAAAB7Kea7HkN4Eo="
											},
											"tail": {
												"$ref": "AAAAAAABfbQ+4YNuhoI="
											},
											"points": "490:231.0;900:115.0"
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAABrQ3/HwnbcYQ=",
											"_parent": {
												"$ref": "AAAAAAABfqwt8qMFgwQ="
											},
											"font": "Arial;13;0",
											"left": 60,
											"top": 850,
											"width": 430,
											"height": 80,
											"text": "Links: BLE GATT (app<->esp), HTTPS + JWT (app<->api, esp<->api),\nPWM GPIO27 (esp->actuator), JDBC (api/pss/pay<->db).\nPayment is the in-process MockPaymentService (MOCK- receipts);\nScheduledSessionAborter aborts stale CREATED sessions."
										},
										{
											"_type": "UMLNoteLinkView",
