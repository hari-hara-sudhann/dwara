# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- PostgreSQL -------------------------------------------------------------
DB_USER=dwara_user
DB_PASSWORD=change-me
DB_NAME=dwara_db
DB_PORT=5432

# Connection string used when running the backend outside compose.
DB_URL=jdbc:postgresql://localhost:5432/dwara_db

# --- Backend ----------------------------------------------------------------
APP_PORT=8080

# Base64 of at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-base64-random-32-bytes
# Token lifetime in milliseconds (3600000 = 1 hour).
JWT_EXPIRATION=3600000

# Admin key for facility/device provisioning. Blank closes the admin surface.
# Generate with `openssl rand -hex 16`.
DWARA_ADMIN_KEY=

# --- Demo seed --------------------------------------------------------------
# Seeds an ACTIVE FAC-0001 facility on first startup. Set false in production.
DWARA_SEED_DEMO_FACILITY=true
